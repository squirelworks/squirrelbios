# SquirrelBIOS sparc64-sun4u (roadmap E2) cases, sourced by tests/smoke.sh.
# Needs qemu-system-sparc64 (Ubuntu: qemu-system-sparc) and the firmware,
# which needs a sparc64 cross gcc; without either the cases are skipped.
# CI installs both (.github/workflows).

QEMU_SPARC64=${QEMU_SPARC64:-qemu-system-sparc64}
SPARC64_FW=sparc64/squirrel-bios.bin

sparc64_case() {
    if ! command -v "$QEMU_SPARC64" >/dev/null 2>&1; then
        skip "$1" "no $QEMU_SPARC64"
    elif [ ! -f "$SPARC64_FW" ] || [ ! -f "$TEST_DIR/sparc64-kernel.elf" ]; then
        skip "$1" "sparc64 firmware not built (no sparc64 cross gcc)"
    else
        run "$@"
    fi
}

SPARC64_OK="OS-ENTRY sparc64 cif=ok state=ok mmu=ok tba=ok windows=ok|CIF test=ok unknown=ok mem=ok walk=ok nodes=9 missing=ok alias=ok|MMU translate=ok translations=ok method=ok claim=ok ms=ok interpret=ok|cif: exit|sq> "

# The firmware copies itself from the PROM to the top 4 MB of RAM, runs
# there at 0xf0000000 with the MMUs on, and enters the test kernel (an
# ELF at 0x404000, like Linux) with %o4 = its IEEE 1275-style client
# interface. The kernel recurses deep enough to need the firmware's
# window spill/fill traps, then uses only the client interface: device
# tree walk, properties, an alias, the stdout instance, the MMU's
# translate, claim, milliseconds; exit returns to the sq> prompt
sparc64_case sparc64-boot "SquirrelBIOS SPARC|firmware at 0xf0000000 (physical 0x7c00000)|bootargs: quiet|boot: kernel at 0x404000|$SPARC64_OK|!=bad|!trap:" \
    "$QEMU_SPARC64" -M sun4u -bios $SPARC64_FW -kernel $TEST_DIR/sparc64-kernel.elf -append quiet

# More RAM: the firmware moves to the new top
sparc64_case sparc64-512m "firmware at 0xf0000000 (physical 0x1fc00000)|mem: 512 MB|$SPARC64_OK|!=bad|!trap:" \
    "$QEMU_SPARC64" -M sun4u -m 512 -bios $SPARC64_FW -kernel $TEST_DIR/sparc64-kernel.elf

# No kernel: the firmware prompt, its commands and the device tree
SERIAL_IN=$TEST_DIR/sparc64-prompt.keys
sparc64_case sparc64-prompt "boot: no kernel (-kernel)|sq> |commands:|  dt |available: 0x4000-0x7bfffff|chosen {|stdout = <0x51530001>|unknown command 'bogus'|!trap:" \
    "$QEMU_SPARC64" -M sun4u -bios $SPARC64_FW
SERIAL_IN=

# Build configs: configs/sparc64-sun4u/default.cfg boots the same way
SPARC64_FW=build/sparc64-sun4u/default/squirrel-bios.bin
sparc64_case config-sparc64-default "SquirrelBIOS SPARC|$SPARC64_OK" \
    "$QEMU_SPARC64" -M sun4u -bios $SPARC64_FW -kernel $TEST_DIR/sparc64-kernel.elf
SPARC64_FW=sparc64/squirrel-bios.bin
